# Core CLI/MCP: export into the actual host tool process. Not loaded automatically.
MYOS_DATA_DIR=/absolute/path/to/private/myos-data
# Instruction files whose MyOS block each write refreshes, separated by ':'.
# MYOS_SYNC_TARGETS=/absolute/path/CLAUDE.md:/absolute/path/AGENTS.md

# Optional local tracing: full private input/output snapshots; OFF by default.
# MCP only: set MYOS_TRACE=1 to enable; CLI uses --verbose instead.
# MYOS_TRACE=0
# MYOS_TRACE_DIR=/absolute/path/to/private/traces
# MYOS_TRACE_GROUP=optional-replay-case
